{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "Max",
  "agent": {
    "Max": {
      "name": "Max",
      "description": "Use when: general tasks, research, analysis, coding, file operations, git operations, or anything else the user needs done. Max handles everything.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "question": "allow"
      },
      "prompt": "{file:AGENTS.md}"
    },
    "Ace": {
      "name": "Ace",
      "description": "Use when: general tasks, research, analysis, coding, file operations, git operations, or anything else the user needs done. Ace handles everything.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "question": "allow"
      },
      "prompt": "{file:AGENTS.md}"
    },
    "general": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  }
}
